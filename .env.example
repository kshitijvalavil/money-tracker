# Copy to .env for local development (never commit the real .env).
# Find these in your Supabase project: Settings -> API.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Optional: set to 1 to explore the UI with fake data and no login.
# Leave unset / 0 for real use.
# DEMO_MODE=0

# Optional: shown on the privacy notice and security.txt as the contact for privacy questions.
# PRIVACY_CONTACT_EMAIL=you@example.com
# Optional: set to 1 to show everyone the friendly "we are updating" page (planned maintenance).
# MAINTENANCE_MODE=0
# Optional: how many reverse proxies sit in front of the app (Render: 1). Used to read the real client IP.
# TRUSTED_PROXIES=1

