# Copy to .env for local development (never commit the real .env).
# Find these in your Supabase project: Settings -> API.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Optional: set to 1 to explore the UI with fake data and no login.
# Leave unset / 0 for real use.
# DEMO_MODE=0
